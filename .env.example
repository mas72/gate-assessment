PORT=443
HTTP_PORT=3080
HTTPS=true
TLS_CERT=certs/fullchain.pem
TLS_KEY=certs/key.pem
# Local HTTP API for Vite (`npm run server`): PORT=3001
# Optional nginx TLS terminate instead of Node on :443:
# PROXY_TLS=true
# BIND_HOST=127.0.0.1
# HTTP_PORT=0
# PORT=3001
SESSION_SECRET=change-this-dev-session-secret
ADMIN_PASSWORD=gate-admin-change-me
